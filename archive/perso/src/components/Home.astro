---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@/modules/about/components/AboutSection.astro";
import BlogSection from "@/modules/blog/components/BlogSection.astro";
import ProPage from "@/modules/pro/components/ProPage.astro";
import ActiveProjectSection from "@/modules/project/components/ActiveProjectSection.astro";
import ProjectDetailModal from "@/modules/project/components/ProjectDetailModal.astro";
import ResumeDialog from "@/modules/resume/components/ResumeDialog.astro";
---

<MainLayout>
	<!-- One block per mode (see docs/DIRECTION.md); the empty ones are still to build. -->
	<ProPage />
	<div data-mode-only="explore"></div>
	<div data-mode-only="creatif"></div>
	<div id="main-content" data-mode-only="perso" class="w-full relative flex flex-col items-center">
		<div class="flex justify-center pb-12">
			<div class="w-full flex flex-col items-center max-w-160 pt-30 relative pb-4">
				<div class="w-full space-y-16 relative">
					<AboutSection />
					<ActiveProjectSection />
					<BlogSection />
				</div>
			</div>
		</div>
	</div>
	<ProjectDetailModal />
	<ResumeDialog />
</MainLayout>
