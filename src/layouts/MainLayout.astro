---
import { Font } from "astro:assets";
import Footer from "@/components/Footer.astro";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import Clock from "@/modules/clock/components/Clock.astro";
import TreeShadow from "@/modules/tree-shadow/components/TreeShadow.astro";
import PostHog from "@/services/analytics/PostHog.astro";
import { lightTones, timeOfDay } from "@/modules/tree-shadow/lib/tree-shadow";
import Seo, { type Props as SeoProps } from "@/services/seo/Seo.astro";
import { LANGUAGE_TAGS, toLocale } from "@/services/i18n";

type Props = SeoProps;

const locale = toLocale(Astro.currentLocale);

// The light's full-sun color for each local hour, for the head script below.
const sunByHour = Array.from({ length: 24 }, (_, hour) =>
  lightTones[timeOfDay(hour)].sun.map((c) => Math.round(c * 255)).join(" "),
);
---

<html lang={LANGUAGE_TAGS[locale]} class="w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...Astro.props} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-cabin" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-inter" />

    <PostHog />
    <!-- The room is lit from the first paint: TreeShadow's canvas shows this color until WebGL draws over it. -->
    <script is:inline define:vars={{ sunByHour }}>
      document.documentElement.style.setProperty("--light-sun", `rgb(${sunByHour[new Date().getHours()]})`);
    </script>
  </head>
  <body class="w-full">
    <!-- An opaque sheet over the fixed footer, which shows once scrolled past it (see Footer). -->
    <main id="page" class="relative z-20 bg-white">
      <slot />
    </main>
    <Footer />
    <TreeShadow />
    <Clock />
    <LanguageSwitch />
  </body>
</html>
