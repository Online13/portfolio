---
import { Font } from "astro:assets";
import ResumeDialog from "@/modules/resume/components/ResumeDialog.astro";
import PostHog from "@/services/analytics/PostHog.astro";
import Seo, { type Props as SeoProps } from "@/services/seo/Seo.astro";
import { LANGUAGE_TAGS, toLocale } from "@/services/i18n";

type Props = SeoProps;

const locale = toLocale(Astro.currentLocale);
---

<html lang={LANGUAGE_TAGS[locale]} class="w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...Astro.props} />
    <meta name="theme-color" content="#171717" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-inter" preload />

    <PostHog />
  </head>
  <body class="w-full bg-neutral-900">
    <!-- The resume's print styles keep only what is inside #page (see resume.css). -->
    <main id="page" class="relative min-h-screen">
      <slot />
      <!-- Any link to #resume opens it over the page it is on. -->
      <ResumeDialog />
    </main>
  </body>
</html>
