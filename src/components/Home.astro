---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@/modules/about/components/AboutSection.astro";
import BlogSection from "@/modules/blog/components/BlogSection.astro";
import ActiveProjectSection from "@/modules/project/components/ActiveProjectSection.astro";
import ProjectDetailModal from "@/modules/project/components/ProjectDetailModal.astro";
import ResumeDialog from "@/modules/resume/components/ResumeDialog.astro";
---

<MainLayout>
	<div id="main-content" class="w-full relative flex flex-col items-center">
		<div class="w-full flex justify-center px-6 pb-12 sm:px-8">
			<div class="w-full flex flex-col items-center max-w-160 pt-24 sm:pt-30 relative pb-4">
				<div class="w-full space-y-16 relative">
					<AboutSection />
					<ActiveProjectSection />
					<BlogSection />
				</div>
			</div>
		</div>
	</div>
	<ProjectDetailModal />
	<ResumeDialog />
</MainLayout>
