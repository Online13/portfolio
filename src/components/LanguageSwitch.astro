---
import { localizePath, LOCALES, t, toLocale } from "@/services/i18n";

// Each page places and colors its own switch; the links take the text color, dimmed unless current.
type Props = { class?: string };

const locale = toLocale(Astro.currentLocale);
const { label, names } = t(locale).language;
---

<!-- Each language is its own page (/ and /fr/): the links lead to this page in the other one. -->
<nav aria-label={label} class:list={["flex items-center gap-1 text-sm", Astro.props.class]}>
	{
		LOCALES.map((option, i) => (
			<>
				{i > 0 && <span aria-hidden="true" class="opacity-30">/</span>}
				<a
					href={localizePath(Astro.url.pathname, option)}
					hreflang={option}
					lang={option}
					title={names[option]}
					aria-current={option === locale ? "page" : undefined}
					data-language-switch
					class="uppercase opacity-60 hover:opacity-100 aria-[current=page]:font-semibold aria-[current=page]:opacity-100"
				>
					{option}
				</a>
			</>
		))
	}
</nav>

<script>
	// Keep the open resume (#resume) in the other language.
	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]")) {
		link.addEventListener("click", () => {
			link.hash = location.hash;
		});
	}
</script>
