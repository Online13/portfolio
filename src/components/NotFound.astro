---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import { homePath, t, toLocale } from "@/services/i18n";

const locale = toLocale(Astro.currentLocale);
const text = t(locale).notFound;
---

<MainLayout title={text.title} noindex>
	<div class="pro min-h-screen bg-surface text-ink">
		<div class="pro-container space-y-6 py-16 md:py-20">
			<h1 class="text-3xl font-semibold leading-[1.12] tracking-tight md:text-5xl">
				<span class="block text-ink-muted">404</span>
				<span class="block">{text.message}</span>
			</h1>
			<p class="max-w-140 text-lg text-ink-muted">
				{text.hint}{" "}
				<a href={homePath(locale)} class="text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:decoration-brand">{text.back}</a>.
			</p>
		</div>
	</div>
</MainLayout>
