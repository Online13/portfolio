---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import { homePath, t, toLocale } from "@/services/i18n";

const locale = toLocale(Astro.currentLocale);
const text = t(locale).notFound;
---

<MainLayout title={text.title} noindex>
	<div class="w-full min-h-screen flex justify-center">
		<div class="w-full max-w-160 pt-30 pb-12 space-y-4">
			<div class="space-y-1">
				<h1 class="text-2xl font-bold">404</h1>
				<p class="text-gray-700">{text.message}</p>
			</div>
			<p class="text-gray-600 max-w-130">
				{text.hint}{" "}
				<a href={homePath(locale)} class="trigger text-gray-900 font-semibold">{text.back}</a>.
			</p>
		</div>
	</div>
</MainLayout>
