---
interface Props {
  id?: number;
  "data-network"?: string;
  to: string;
  label: string;
  class?: string;
}

const { to, label, class: className = "", id = 0, ...rest } = Astro.props;
---

<a
  href={to}
  target="_blank"
  aria-label={label}
  {...rest}
  class:list={[
    "group w-full flex justify-center items-center rounded-lg hover:bg-stone-500/10 hover:scale-125 transition-transform duration-200 py-2 px-2",
    className,
    id % 2 ? "hover:rotate-12" : "hover:-rotate-12",
  ]}
>
  <slot />
</a>
