---
import { ArrowUpRight } from "@lucide/astro";
import SocialNetworkLinks from "@/modules/social/components/SocialNetworkLinks.astro";
import { getExperienceYears } from "@/services/content";
import { t, toLocale } from "@/services/i18n";

const { about, pro } = t(toLocale(Astro.currentLocale));
const story = about.story(await getExperienceYears());
---

<!-- Who I am: my name and role, what I do, what I did, then where I live and how to reach me. -->
<section class="pro-container py-16 md:py-24">
	<h1 class="text-2xl font-bold leading-[1.1] tracking-tight md:text-4xl">
		<span class="mb-2 block text-sm font-medium text-ink-muted md:text-base"
			>{pro.hero.greeting}</span
		>
		<span data-pro-hero-name class="block text-ink-muted"
			>Nekena <span class="text-ink">Rayane.</span></span
		>
		<span class="mt-2 block text-lg font-semibold text-brand md:text-2xl"
			>{pro.hero.role}</span
		>
	</h1>
	<div class="mt-10 max-w-160 space-y-5 text-lg text-ink-muted">
		{story.map((paragraph) => <p>{paragraph}</p>)}
		<div class="space-y-4">
			<p>
				{about.location}
				{about.available}{" "}
				<a
					href="#resume"
					class="group inline-flex items-center gap-1 text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:decoration-brand"
				>
					{about.resume}
					<ArrowUpRight
						class="size-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					/>
				</a>
			</p>
			<SocialNetworkLinks />
		</div>
	</div>
</section>
