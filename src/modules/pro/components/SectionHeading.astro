---
// A section's two-tone title: what it is, dimmed, then what it says.
type Props = { kicker: string; title: string };

const { kicker, title } = Astro.props;
---

<h2 class="text-3xl font-semibold leading-[1.12] tracking-tight md:text-4xl">
	<span class="block text-neutral-400">{kicker}</span>
	<span class="block">{title}</span>
</h2>
