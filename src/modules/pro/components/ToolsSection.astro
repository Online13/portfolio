---
import FluidHover from "@/components/FluidHover.astro";
import { getResume } from "@/services/content";
import { t, toLocale } from "@/services/i18n";
import SectionHeading from "./SectionHeading.astro";

const locale = toLocale(Astro.currentLocale);
const text = t(locale).pro.tools;
// The same list as the resume.
const { tools } = await getResume(locale);
---

<section class="space-y-12 border-t border-ink/10 pt-20 md:pt-28">
	<div class="pro-container">
		<SectionHeading kicker={text.kicker} title={text.title} />
	</div>
	<FluidHover class="[--fluid-radius:0]">
	<dl class="border-b border-ink/10">
		{
			tools.map(({ label, value }) => (
				<div data-fluid-item class="group border-t border-ink/10 py-5">
					<div class="pro-container grid gap-1 md:grid-cols-12 md:gap-6">
						<dt class="text-sm text-brand md:col-span-3">{label}</dt>
						<dd class="text-lg md:col-span-9">{value}</dd>
					</div>
				</div>
			))
		}
	</dl>
	</FluidHover>
</section>
