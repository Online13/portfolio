---
import FluidHover from "@/components/FluidHover.astro";
import { Plus, X } from "@lucide/astro";
import { t, toLocale } from "@/services/i18n";
import SectionHeading from "./SectionHeading.astro";
import Tags from "./Tags.astro";

const ui = t(toLocale(Astro.currentLocale));
const text = ui.pro.services;
const items = text.items.map((item, i) => ({ ...item, dialog: `pro-service-${i}` }));
const row = "border-t border-white/10 py-8";
const rowGrid = "pro-container grid gap-3 md:grid-cols-12 md:gap-6";
const label = "text-sm text-neutral-400 md:col-span-3";
---

<section id="pro-services" class="scroll-mt-16 space-y-12 border-t border-white/10 pt-20 md:pt-28">
	<div class="pro-container">
		<SectionHeading kicker={text.kicker} title={text.title} />
	</div>
	<!-- The gaps let the grid's background through as hairlines between the cards. -->
	<div class="border-y border-white/10">
		<div class="pro-container">
			<FluidHover axis="xy" class="[--fluid-radius:0] [--fluid-z:1]">
			<!-- Pulled out by the cards' padding, so the first card's text lines up with the heading. -->
			<ul class="grid gap-px bg-white/10 md:-mx-6 md:grid-cols-2 xl:grid-cols-4">
		{
			items.map(({ title, description, tags, dialog }) => (
				<li data-fluid-item class="group flex cursor-pointer flex-col gap-4 bg-neutral-900 py-8 md:px-6">
					<h3 class="text-xl font-semibold tracking-tight">
						<!-- A click anywhere on the card lands here (see FluidHover). -->
						<button type="button" data-service-open={dialog} aria-haspopup="dialog" class="flex w-full cursor-pointer items-center justify-between gap-2 text-left">
							{title}
							<Plus class="size-4 shrink-0 text-neutral-400 transition group-data-fluid-active:rotate-90 group-data-fluid-active:text-white" />
						</button>
					</h3>
					<p class="grow text-neutral-400">{description}</p>
					<Tags tags={tags} />
				</li>
			))
		}
			</ul>
			</FluidHover>
		</div>
	</div>
	<!-- A service, opened: a sheet over the whole page that scrolls through the tools and the steps of the work. -->
	{
		items.map(({ title, description, tools, testing, steps, dialog }) => (
			<dialog
				id={dialog}
				aria-labelledby={`${dialog}-title`}
				class="fixed inset-0 size-full max-h-none max-w-none overflow-y-auto overscroll-contain bg-neutral-900 text-neutral-200 opacity-0 transition duration-300 ease-out open:opacity-100 starting:open:translate-y-4 starting:open:opacity-0 motion-reduce:transition-none"
			>
				<div class="sticky top-0 z-10 bg-neutral-900/70 backdrop-blur-md">
					<form method="dialog" class="pro-container flex justify-end py-4">
						<button class="inline-flex cursor-pointer items-center gap-1.5 text-sm text-neutral-400 transition-colors hover:text-white">
							{ui.projects.close}
							<X class="size-4" />
						</button>
					</form>
				</div>
				<div class="pro-container space-y-6 py-16 md:py-20">
					<h3 id={`${dialog}-title`} class="text-xl font-semibold leading-[1.12] tracking-tight md:text-3xl">
						<span class="block text-neutral-400">{text.kicker}</span>
						<span class="block">{title}</span>
					</h3>
					<p class="max-w-140 text-lg text-neutral-400">{description}</p>
				</div>
				<section class={row}>
					<div class={rowGrid}>
						<h4 class={label}>{text.labels.tools}</h4>
						<div class="space-y-10 md:col-span-6">
							{[{ name: undefined, list: tools }, { name: text.labels.testing, list: testing }].map((group) => (
								<div class="space-y-3">
									{group.name && <h5 class="text-sm text-neutral-500">{group.name}</h5>}
									<ul class="divide-y divide-white/10 border-y border-white/10">
										{group.list.map((tool) => (
											<li class="space-y-1 py-4">
												<p class="text-xl font-semibold tracking-tight">{tool.name}</p>
												<p class="text-neutral-400">{tool.text}</p>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				</section>
				<section class:list={[row, "pb-20 md:pb-28"]}>
					<div class={rowGrid}>
						<h4 class={label}>{text.labels.process}</h4>
						<ol class="space-y-10 md:col-span-6">
							{steps.map((step, i) => (
								<li class="space-y-1">
									<p class="text-sm text-neutral-500 tabular-nums">{String(i + 1).padStart(2, "0")}</p>
									<p class="text-xl font-semibold tracking-tight">{step.title}</p>
									<p class="text-neutral-400">{step.text}</p>
								</li>
							))}
						</ol>
					</div>
				</section>
			</dialog>
		))
	}
</section>

<script>
	for (const opener of document.querySelectorAll<HTMLElement>("[data-service-open]")) {
		const dialog = document.getElementById(opener.dataset.serviceOpen!) as HTMLDialogElement;
		opener.addEventListener("click", () => dialog.showModal());
	}
</script>
