---
type Props = { tags: string[] };

const { tags } = Astro.props;
---

<ul class="flex flex-wrap content-start gap-1.5">
	{tags.map((tag) => <li class="rounded-full border border-white/15 px-2.5 py-0.5 text-xs text-neutral-300 transition-colors hover:border-white/40 hover:text-white">{tag}</li>)}
</ul>
