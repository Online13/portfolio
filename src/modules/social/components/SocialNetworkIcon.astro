---
import type { IconType } from "@/type";
import EmailIcon from "@/modules/social/icons/EmailIcon.astro";
import FacebookIcon from "@/modules/social/icons/FacebookIcon.astro";
import GithubIcon from "@/modules/social/icons/GithubIcon.astro";
import LinkedinIcon from "@/modules/social/icons/LinkedinIcon.astro";
import WhatsappIcon from "@/modules/social/icons/WhatsappIcon.astro";

interface Props {
  type: IconType;
}

const { type } = Astro.props;
---

{type === "github" && <GithubIcon />}
{type === "linkedin" && <LinkedinIcon />}
{type === "whatsapp" && <WhatsappIcon />}
{type === "facebook" && <FacebookIcon />}
{type === "email" && <EmailIcon />}
