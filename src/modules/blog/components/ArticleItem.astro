---
import { formatArticleDate } from "@/modules/blog/utils/dates";
import { t, toLocale } from "@/services/i18n";

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
	draft?: boolean;
}

const { title, description, date, draft } = Astro.props;
const locale = toLocale(Astro.currentLocale);
---

<div class="w-full grid grid-cols-1 gap-1 py-3 sm:grid-cols-[5fr_1fr] sm:gap-4">
	<div class="flex flex-col gap-1">
		<div class="flex items-center gap-2">
			<h3 class="text-base font-semibold text-black">
				{title}
			</h3>
			{draft && <span class="text-sm text-gray-600">{t(locale).blog.draft}</span>}
		</div>
		<p class="text-sm text-gray-600">
			{description}
		</p>
	</div>
	<div class="sm:text-right">
		<time datetime={date.toISOString()} class="text-sm text-gray-600">
			{formatArticleDate(date, locale)}
		</time>
	</div>
</div>
