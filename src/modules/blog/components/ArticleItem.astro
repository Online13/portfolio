---
import { formatArticleDate } from "@/modules/blog/utils/dates";

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
	draft?: boolean;
}

const { title, description, date, draft } = Astro.props;
---

<div class="w-full grid grid-cols-[5fr_1fr] gap-4 py-3">
	<div class="flex flex-col gap-1">
		<div class="flex items-center gap-2">
			<h3 class="text-base font-semibold text-black">
				{title}
			</h3>
			{draft && <span class="text-sm text-gray-600">(in progress)</span>}
		</div>
		<p class="text-sm text-gray-600">
			{description}
		</p>
	</div>
	<div class="text-right">
		<time datetime={date.toISOString()} class="text-sm text-gray-600">
			{formatArticleDate(date)}
		</time>
	</div>
</div>
