---
import "@/styles/global.css";
import { ArrowRight } from "@lucide/astro";
import FluidHover from "@/components/FluidHover.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import ProFooter from "@/modules/pro/components/ProFooter.astro";
import SiteHeader from "@/modules/pro/components/SiteHeader.astro";
import { getArticles } from "@/services/content";
import { t, toLocale } from "@/services/i18n";
import { articlePath, formatArticleDate } from "../lib/blog";

const locale = toLocale(Astro.currentLocale);
const { blog: text, pro } = t(locale);
const articles = await getArticles(locale);
// One section per category, in the order the interface text lists them.
const categories = Object.entries(text.categories).map(([category, heading]) => ({
	heading,
	articles: articles.filter((article) => article.category === category),
}));
---

<MainLayout title={pro.nav.blog} description={text.title}>
	<div class="pro min-h-screen bg-neutral-900 text-neutral-200">
		<!-- As on the home page: an opaque sheet over the footer, which shows once scrolled past it. -->
		<div class="relative z-10 border-b border-white/10 bg-neutral-900">
		<SiteHeader />

		<div class="pro-container py-12 md:py-16 md:pb-8">
			<h1 class="text-xl font-semibold leading-tight tracking-tight md:text-2xl">
				<span class="block text-neutral-400">{text.kicker}</span>
				<span class="block">{text.title}</span>
			</h1>
		</div>

		{
			categories.map(({ heading, articles }) => (
				<section class="border-t border-white/10 py-12 md:py-16">
					<!-- The category's title on the left, its articles on the right. -->
					<div class="pro-container grid gap-8 md:grid-cols-12 md:gap-6">
						<div class="md:col-span-4">
							<!-- Small, so the articles' titles are what stands out. -->
							<h2 class="font-semibold leading-snug tracking-tight">
								<span class="block text-neutral-400">{heading.kicker}</span>
								<span class="block">{heading.title}</span>
							</h2>
						</div>
						<div class="md:col-span-8">
							{articles.length === 0 && <p class="text-neutral-400">{text.empty}</p>}
							<!-- Pulled out by the rows' padding, so their text lines up with the column. -->
							<FluidHover class="-mx-4">
								<ul>
									{articles.map(({ slug, title, description, date, draft }) => (
										<li data-fluid-item class="group cursor-pointer space-y-2 px-4 py-5">
											<p class="flex items-center gap-3 text-sm text-neutral-400">
												<time datetime={date.toISOString()}>{formatArticleDate(date, locale)}</time>
												{draft && <span class="rounded-full border border-white/15 px-2.5 py-0.5 text-xs text-neutral-300">{text.draft}</span>}
											</p>
											<h3 class="text-2xl font-semibold leading-tight tracking-tight md:text-3xl">
												<!-- A click anywhere on the row lands here (see FluidHover). -->
												<a href={articlePath(locale, slug)} class="inline-flex items-center gap-2">
													{title}
													<ArrowRight class="size-5 shrink-0 text-neutral-400 transition group-data-fluid-active:translate-x-0.5 group-data-fluid-active:text-white" />
												</a>
											</h3>
											<p class="text-neutral-400">{description}</p>
										</li>
									))}
								</ul>
							</FluidHover>
						</div>
					</div>
				</section>
			))
		}
		</div>
		<ProFooter />
	</div>
</MainLayout>
