---
// Sunlight filling the room, with the shadow of a cherry tree coming in from the top-left corner.
// Rendered as a multiply overlay: lit areas stay white/warm, the shadow darkens the page.
import { treeShadowConfig } from "@/modules/shared/lib/tree-shadow";

const winds = [
	{ id: "calm", label: "Calm" },
	{ id: "breeze", label: "Breeze" },
	{ id: "gusty", label: "Gusty" },
	{ id: "storm", label: "Storm" },
];

const wheels = [
	{ id: "hours", label: "Hours", count: 24 },
	{ id: "minutes", label: "Minutes", count: 60 },
];
---

<canvas
	id="tree-shadow"
	aria-hidden="true"
	class="fixed inset-0 w-screen h-screen pointer-events-none z-30 mix-blend-multiply"
></canvas>

<!-- The browser's clock; clicking it lets you pick another time to preview the light. -->
<div class="fixed top-4 left-8 z-40 flex flex-col items-start gap-2 text-sm text-gray-600">
	<button
		id="clock"
		type="button"
		aria-expanded="false"
		aria-controls="clock-picker"
		aria-label="Change the time of the light"
		class="cursor-pointer tabular-nums hover:text-black"
	></button>
	<!-- Two wheels (hours, minutes): scroll, drag, click a number, or use the arrow keys. The centered row is the value. -->
	<div id="clock-picker" hidden class="flex items-center gap-3">
		<div class="relative flex tabular-nums">
			<div aria-hidden="true" class="absolute inset-x-0 top-8 h-8 rounded-md bg-black/5"></div>
			{
				wheels.map(({ id, label, count }) => (
					<div
						data-wheel={id}
						role="spinbutton"
						tabindex="0"
						aria-label={label}
						aria-valuemin="0"
						aria-valuemax={count - 1}
						class="relative h-24 w-10 overflow-y-scroll snap-y snap-mandatory py-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mask-y-from-60% outline-none focus-visible:ring-1 focus-visible:ring-gray-300 rounded-md"
					>
						{Array.from({ length: count }, (_, i) => (
							<div data-value={i} class="h-8 snap-center flex items-center justify-center cursor-pointer">
								{String(i).padStart(2, "0")}
							</div>
						))}
					</div>
				))
			}
		</div>
		<button id="clock-now" type="button" class="cursor-pointer underline hover:text-black">Now</button>
	</div>
</div>

<!-- The branch stays still with reduced motion, so the wind has nothing to change. -->
<div
	role="group"
	aria-label="Wind"
	class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 flex gap-1 p-1 rounded-full bg-white/70 backdrop-blur-sm shadow-lg text-sm motion-reduce:hidden"
>
	{
		winds.map(({ id, label }) => (
			<button
				type="button"
				data-wind={id}
				aria-pressed={id === treeShadowConfig.windMode ? "true" : "false"}
				class="px-3 py-1 rounded-full cursor-pointer text-gray-600 hover:text-black aria-pressed:bg-black aria-pressed:text-white"
			>
				{label}
			</button>
		))
	}
</div>

<script>
	import {
		Mesh,
		OrthographicCamera,
		PlaneGeometry,
		Scene,
		ShaderMaterial,
		Vector2,
		Vector3,
		WebGLRenderer,
		WebGLRenderTarget,
	} from "three";
	import { createSakuraBranch, type WindMode } from "@/modules/shared/lib/sakura-branch";
	import {
		lightTones,
		timeOfDay,
		treeShadowChunk,
		treeShadowConfig as config,
	} from "@/modules/shared/lib/tree-shadow";

	const canvas = document.getElementById("tree-shadow") as HTMLCanvasElement;
	const renderer = new WebGLRenderer({ canvas, alpha: false, antialias: false });
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

	// The branch silhouette, redrawn each frame as the wind moves it.
	const branch = createSakuraBranch(config.seed, config.wind, config.windMode);

	const windButtons = document.querySelectorAll<HTMLButtonElement>("[data-wind]");
	for (const button of windButtons) {
		button.addEventListener("click", () => {
			branch.setWind(button.dataset.wind as WindMode);
			for (const other of windButtons) other.setAttribute("aria-pressed", String(other === button));
		});
	}
	// While a gust blows (see WindGust) the branch storms, catching it at once, then eases back to the chosen weather.
	window.addEventListener("wind-gust-start", () => branch.setWind("storm", 8));
	window.addEventListener("wind-gust-end", () => {
		const chosen = document.querySelector<HTMLButtonElement>('[data-wind][aria-pressed="true"]');
		branch.setWind((chosen?.dataset.wind ?? config.windMode) as WindMode);
	});
	const branchCamera = new OrthographicCamera(0, config.aspect, 0, -1, -1, 1);
	const silhouette = new WebGLRenderTarget(Math.round(1024 * config.aspect), 1024, { samples: 4 });

	const initial = lightTones[timeOfDay(new Date().getHours())];
	const uniforms = {
		uResolution: { value: new Vector2() },
		uTree: { value: silhouette.texture },
		uOrigin: { value: new Vector2(...config.origin) },
		uSize: { value: new Vector2() },
		uStrength: { value: config.strength },
		uSoftness: { value: config.softness },
		uRoom: { value: new Vector3(...initial.room) },
		uSun: { value: new Vector3(...initial.sun) },
	};
	const target = {
		uRoom: new Vector3(...initial.room),
		uSun: new Vector3(...initial.sun),
	};
	const tones = ["uRoom", "uSun"] as const;
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const scene = new Scene();
	scene.add(
		new Mesh(
			new PlaneGeometry(2, 2),
			new ShaderMaterial({
				uniforms,
				vertexShader: "void main() { gl_Position = vec4(position, 1.0); }",
				fragmentShader: /* glsl */ `
					uniform vec2 uResolution;
					${treeShadowChunk}
					void main() {
						vec2 p = gl_FragCoord.xy / uResolution.y;
						gl_FragColor = vec4(treeShadowColor(p, gl_FragCoord.xy), 1.0);
					}
				`,
			}),
		),
	);
	const camera = new OrthographicCamera();

	function draw(seconds: number) {
		branch.update(seconds);
		renderer.setRenderTarget(silhouette);
		renderer.render(branch.scene, branchCamera);
		renderer.setRenderTarget(null);
		renderer.render(scene, camera);
	}

	function resize() {
		renderer.setSize(window.innerWidth, window.innerHeight, false);
		renderer.getDrawingBufferSize(uniforms.uResolution.value);
		// Keep the tree in its corner on narrow screens.
		const height = Math.min(config.size, (config.maxWidth * window.innerWidth) / window.innerHeight / config.aspect);
		uniforms.uSize.value.set(height * config.aspect, height);
		draw(performance.now() / 1000);
	}
	resize();
	window.addEventListener("resize", resize);

	// Follow the browser's clock, or the time picked to preview the light.
	const clock = document.getElementById("clock") as HTMLButtonElement;
	const picker = document.getElementById("clock-picker") as HTMLDivElement;
	const [hoursWheel, minutesWheel] = document.querySelectorAll<HTMLElement>("[data-wheel]");
	let picked: string | null = null; // "hh:mm"
	let shownTone = timeOfDay(new Date().getHours());

	const pad = (n: number) => String(n).padStart(2, "0");
	function now() {
		const date = new Date();
		return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
	}

	// A wheel's value is the row snapped to its center.
	const rowHeight = (wheel: HTMLElement) => wheel.firstElementChild!.clientHeight;
	const wheelValue = (wheel: HTMLElement) => Math.round(wheel.scrollTop / rowHeight(wheel));
	function setWheel(wheel: HTMLElement, value: number, behavior: ScrollBehavior = "instant") {
		const count = wheel.children.length;
		value = Math.min(count - 1, Math.max(0, value));
		wheel.scrollTo({ top: value * rowHeight(wheel), behavior });
		wheel.setAttribute("aria-valuenow", String(value));
		wheel.setAttribute("aria-valuetext", pad(value));
	}

	for (const wheel of [hoursWheel, minutesWheel]) {
		wheel.addEventListener("scroll", () => {
			const time = `${pad(wheelValue(hoursWheel))}:${pad(wheelValue(minutesWheel))}`;
			wheel.setAttribute("aria-valuenow", String(wheelValue(wheel)));
			wheel.setAttribute("aria-valuetext", pad(wheelValue(wheel)));
			// Syncing the wheels to the live clock scrolls them too; that is not a pick.
			if (time === (picked ?? now())) return;
			picked = time;
			updateTime();
		});
		wheel.addEventListener("click", (event) => {
			const row = (event.target as HTMLElement).closest<HTMLElement>("[data-value]");
			if (row) setWheel(wheel, Number(row.dataset.value), "smooth");
		});
		wheel.addEventListener("keydown", (event) => {
			const step = { ArrowUp: -1, ArrowDown: 1, PageUp: -5, PageDown: 5 }[event.key];
			const jump = { Home: 0, End: wheel.children.length - 1 }[event.key];
			if (step === undefined && jump === undefined) return;
			event.preventDefault();
			setWheel(wheel, jump ?? wheelValue(wheel) + step!, "smooth");
		});
	}

	function syncWheels(time: string) {
		setWheel(hoursWheel, Number(time.slice(0, 2)));
		setWheel(minutesWheel, Number(time.slice(3)));
	}

	function updateTime() {
		const time = picked ?? now();
		clock.textContent = time;
		// Hidden wheels have no size to scroll; they are synced when opened.
		if (!picked && !picker.hidden) syncWheels(time);
		const tod = timeOfDay(Number(time.slice(0, 2)));
		if (tod === shownTone) return;
		shownTone = tod;
		const tone = lightTones[tod];
		target.uRoom.set(...tone.room);
		target.uSun.set(...tone.sun);
		if (reducedMotion) {
			for (const key of tones) uniforms[key].value.copy(target[key]);
			draw(0);
		}
	}
	updateTime();
	setInterval(updateTime, 1000);

	clock.addEventListener("click", () => {
		picker.hidden = !picker.hidden;
		clock.setAttribute("aria-expanded", String(!picker.hidden));
		if (picker.hidden) return;
		syncWheels(picked ?? now());
		hoursWheel.focus();
	});
	document.getElementById("clock-now")!.addEventListener("click", () => {
		picked = null;
		syncWheels(now());
		updateTime();
	});

	if (!reducedMotion) {
		let last = 0;
		renderer.setAnimationLoop((time) => {
			// Ease toward the current time of day (a few seconds).
			const ease = 1 - Math.exp(-((time - last) / 1000) * 0.8);
			last = time;
			for (const key of tones) uniforms[key].value.lerp(target[key], ease);
			draw(time / 1000);
		});
	}
</script>
