---
import { ArrowLeft } from "@lucide/astro";
import { getExperiences } from "./experiences";

const experiences = await getExperiences();
const heading =
	"font-mono text-xs font-semibold uppercase tracking-wider text-neutral-400";
---

{
	experiences.map((role) => (
		<article data-experience={role.id} hidden class="space-y-8">
			<header class="space-y-3">
				<a
					href="#resume"
					data-detail-close
					class="-ml-1 inline-flex items-center gap-1.5 rounded-full py-1 pr-2.5 pl-1 text-sm text-gray-600 transition-colors hover:bg-neutral-100 hover:text-black"
				>
					<ArrowLeft class="h-5 w-5" aria-hidden="true" />
					Resume
				</a>
				<div class="space-y-1">
					<h2 class="text-2xl font-bold">{role.role}</h2>
					<p class="text-gray-600">{role.company}</p>
					<p class="text-sm text-gray-400 tabular-nums">
						{role.current && (
							<span
								class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500 align-middle"
								aria-hidden="true"
							/>
						)}
						{role.period} · {role.duration}
					</p>
				</div>
			</header>
			{role.summary && (
				<p class="text-sm leading-relaxed text-neutral-700">{role.summary}</p>
			)}
			{role.highlights.length > 0 && (
				<section class="space-y-2">
					<h3 class={heading}>What I did</h3>
					<ul class="list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-neutral-700">
						{role.highlights.map((highlight) => (
							<li>{highlight}</li>
						))}
					</ul>
				</section>
			)}
			{role.technologies.length > 0 && (
				<section class="space-y-2.5">
					<h3 class={heading}>Technologies</h3>
					<ul class="flex flex-wrap gap-1.5">
						{role.technologies.map((tech) => (
							<li class="inline-flex items-center rounded-md bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-800">
								{tech}
							</li>
						))}
					</ul>
				</section>
			)}
		</article>
	))
}
