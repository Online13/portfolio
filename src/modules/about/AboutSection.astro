---
import SocialNetworkLinks from "./SocialNetworkLinks.astro";

const startMonth = 11;
const startYear = 2021;

const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();

const experienceYears =
	currentYear - startYear + (currentMonth >= startMonth ? 0 : -1);
---

<div class="w-full relative group space-y-1">
	<h1 class="text-2xl font-bold">Nekena Rayane</h1>
	<p class="text-gray-700">Software engineer / React Native enthusiast</p>
</div>
<div class="space-y-4 text-gray-600">
	<div class="max-w-130 w-full">
		<span class="max-w-140">
			<b>Hi</b>, I'm <img
				src="https://rayane-nekena.is-a.dev/assets/profile-8952f84b.webp"
				alt="profile picture"
				class="inline shrink-0 w-6 h-6 bg-center bg-cover"
			/>
			<b>Rayane</b>. Born and based in Antananarivo, Madagascar. Curious by
			nature, I enjoy exploring how things are built and making them better.
		</span>
	</div>
	<div class="max-w-130 w-full">
		<span class="max-w-140">
			I'm a <b>software engineer</b> with {experienceYears} years of experience{
				" "
			}
			<b>building web and mobile applications</b>. I focus on scalable
			systems, clean architecture, and performance.
		</span>
	</div>
	<div class="max-w-130 w-full">
		<span class="max-w-140">
			Recently, I've been focusing on mobile applications with <b
				>React Native</b
			>. I work as a consultant at <b>Itwedo</b> and build a personal project on
			the side.
		</span>
	</div>
	<div class="max-w-130 w-full">
		<span class="max-w-140">
			Before that, I worked on <b>digitalization projects</b> for both public and
			private sectors, and contributed to <b
				>frontend refactoring on large-scale applications</b
			>.
		</span>
	</div>
	<p>
		Available for <b>remote collaborations</b>.{" "}
		<a
			href="#resume"
			data-resume-open
			class="group/link text-black hover:underline hover:underline-offset-4 hover:decoration-solid"
		>
			<span>View full resume</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 20 20"
				fill="currentColor"
				class="inline-block h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none ml-1 translate-y-px"
				aria-hidden="true"
				><path
					fill-rule="evenodd"
					d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
					clip-rule="evenodd"></path></svg
			>
		</a>
	</p>
	<div class="grid gap-2 text-black">
		<p class="text-gray-500">Find me on :</p>
		<SocialNetworkLinks />
	</div>
</div>
