---
import SocialLink from "@/components/SocialLink.astro";
import SocialNetworkIcon from "./SocialNetworkIcon.astro";
import { SOCIAL_LINKS } from "@/data";
---

<div class="w-full flex items-center gap-2">
  {
    SOCIAL_LINKS.map((link, id) => (
      <div>
        <SocialLink
          id={id}
          to={link.to}
          data-network={link.type}
          class={link.type === "linkedin" ? "hover:-rotate-18" : undefined}
        >
          <SocialNetworkIcon type={link.type} />
        </SocialLink>
      </div>
    ))
  }
</div>

<script>
  import { track } from "@/services/analytics";

  for (const link of document.querySelectorAll<HTMLElement>("[data-network]")) {
    link.addEventListener("click", () => track("social_link_clicked", { network: link.dataset.network }));
  }
</script>
