---

---

<div
	id="project-modal"
	class="hidden fixed z-20 inset-0 w-screen h-screen"
>
	<div
		id="modal-overlay"
		class="bg-black/5 backdrop-blur-sm fixed inset-0 w-screen h-screen z-10 cursor-pointer"
	>
	</div>
	<div
		id="modal-card"
		class="absolute z-20 bottom-[3%] right-[3%] flex flex-col gap-6 p-4 w-full max-w-xs rounded-2xl border border-neutral-200 bg-white shadow-2xl"
	>
		<button
			id="modal-close"
			type="button"
			class="absolute right-5 top-5 rounded-full border border-neutral-100 w-6 aspect-square text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700"
			aria-label="Fermer"
		>
			✕
		</button>

		<header class="space-y-1 pr-8">
			<span
				class="inline-flex rounded-md border border-neutral-200/60 bg-neutral-50 px-2.5 py-1 font-mono text-xs font-semibold text-neutral-800"
			>
				Project Detail
			</span>

			<h3
				id="modal-title"
				class="text-lg font-bold tracking-tight text-neutral-900"
			>
				<!-- Project Title -->
			</h3>

			<p
				id="modal-description"
				class="font-mono text-sm font-medium text-neutral-500"
			>
				<!-- Mini summary goes here -->
			</p>
		</header>

		<section id="modal-role-section" class="space-y-2">
			<h4
				class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-400"
			>
				Role
			</h4>

			<p id="modal-role" class="text-sm text-neutral-800"></p>
		</section>

		<section class="space-y-2">
			<h4
				class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-400"
			>
				Description
			</h4>

			<p id="modal-detail" class="text-sm leading-relaxed text-neutral-600">
				<!-- Full markdown description goes here. -->
			</p>
		</section>

		<section id="modal-highlights-section" class="space-y-2">
			<h4
				class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-400"
			>
				Highlights
			</h4>

			<ul
				id="modal-highlights"
				class="list-disc space-y-1 pl-4 text-sm text-neutral-600"
			>
			</ul>
		</section>

		<section class="space-y-2.5">
			<h4
				class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-400"
			>
				Technologies
			</h4>

			<div id="modal-techs" class="flex flex-wrap gap-1.5">
				<!-- Technologies will be populated here -->
			</div>
		</section>

		<footer
			class="mt-2 hidden items-center gap-3 border-t border-neutral-100 pt-5"
		>
			<a
				id="modal-link"
				href="#"
				target="_blank"
				rel="noreferrer"
				class="flex-1 rounded-xl bg-neutral-900 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-neutral-800"
			>
				Voir sur GitHub
			</a>

			<button
				id="modal-close-secondary"
				type="button"
				class="flex-1 rounded-xl border border-neutral-200 py-3 text-sm font-semibold text-neutral-600 transition-colors hover:bg-neutral-50"
			>
				Fermer
			</button>
		</footer>
	</div>
</div>
<style>
	#modal-card {
		transform: translateX(110%);
	}

	#modal-card.is-entering {
		animation: modal-enter 0.3s ease-out forwards;
	}

	#modal-card.is-leaving {
		animation: modal-leave 0.4s ease-in forwards;
	}

	@keyframes modal-enter {
		from { transform: translateX(110%); }
		to { transform: translateX(0); }
	}

	@keyframes modal-leave {
		from { transform: translateX(0); }
		to { transform: translateX(110%); }
	}
</style>
<script>
	interface Project {
		slug: string;
		title: string;
		description: string;
		full_description: string;
		technologies: string[];
		link: string;
		role: string;
		highlights: string[];
	}

	function openModal(project: Project) {
		const modal = document.getElementById("project-modal");

		const modalOverlay = document.getElementById("modal-overlay");
		const closeBtn = document.getElementById("modal-close");
		const modalTitle = document.getElementById("modal-title");
		const modalDescription = document.getElementById("modal-description");
		const modalDetail = document.getElementById("modal-detail");
		const modalTechs = document.getElementById("modal-techs");
		const modalLink = document.getElementById("modal-link");

		// Update modal content
		if (modalTitle) modalTitle.textContent = project.title;
		if (modalDescription) modalDescription.textContent = project.description;
		if (modalDetail) modalDetail.textContent = project.full_description;
		const modalRole = document.getElementById("modal-role");
		const modalHighlights = document.getElementById("modal-highlights");
		document
			.getElementById("modal-role-section")
			?.classList.toggle("hidden", !project.role);
		document
			.getElementById("modal-highlights-section")
			?.classList.toggle("hidden", project.highlights.length === 0);
		if (modalRole) modalRole.textContent = project.role;
		if (modalHighlights) {
			modalHighlights.innerHTML = "";
			project.highlights.forEach((highlight) => {
				const item = document.createElement("li");
				item.textContent = highlight;
				modalHighlights.appendChild(item);
			});
		}
		if (modalTechs) {
			modalTechs.innerHTML = "";
			project.technologies.forEach((tech) => {
				const techSpan = document.createElement("span");
				techSpan.className =
					"inline-flex items-center rounded-md bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-800";
				techSpan.textContent = tech;
				modalTechs.appendChild(techSpan);
			});
		}
		if (modalLink && modalLink instanceof HTMLAnchorElement) {
			modalLink.href = project.link;
		}

		// Show modal
		if (modal && modal instanceof HTMLDivElement) {
			const modalCard = document.getElementById("modal-card");
			const modalOverlay = document.getElementById("modal-overlay");

			modalCard?.classList.remove("is-leaving");
			modal.classList.remove("hidden");
			// Force reflow so the entering animation restarts cleanly
			modalCard?.getBoundingClientRect();
			modalCard?.classList.add("is-entering");

			if (closeBtn) {
				closeBtn.addEventListener("click", () => closeModal(modal), { once: true });
			}
			if (modalOverlay) {
				modalOverlay.addEventListener("click", () => closeModal(modal), { once: true });
			}
		}
	}

	function closeModal(modal: HTMLDivElement) {
		const modalCard = document.getElementById("modal-card");
		if (!modalCard) return;

		modalCard.classList.remove("is-entering");
		modalCard.classList.add("is-leaving");

		modalCard.addEventListener(
			"animationend",
			() => {
				modal.classList.add("hidden");
				modalCard.classList.remove("is-leaving");
			},
			{ once: true }
		);
	}

	const projectItems = document.querySelectorAll(".project-item");
	for (const item of projectItems) {
		if (!item || !(item instanceof HTMLElement)) continue;

		const project: Project = {
			slug: "",
			title: "",
			description: "",
			full_description: "",
			technologies: [],
			link: "",
			role: "",
			highlights: [],
		};

		project.slug = item.dataset.slug || "";
		project.link = item.dataset.link || "";
		project.title = item.dataset.title || "";
		project.description = item.dataset.description || "";
		project.role = item.dataset.role || "";

		const fullDescElmt = item.querySelector(".project-full-desc");
		if (fullDescElmt && fullDescElmt instanceof HTMLElement) {
			project.full_description = fullDescElmt.innerHTML.trim();
		}

		const techElmt = item.querySelector(".projet-technos");
		const technos = techElmt?.querySelectorAll("li");
		(technos || []).forEach((tech) => {
			const value = tech.textContent.trim();
			project.technologies.push(value);
		});

		item.querySelectorAll(".project-highlights li").forEach((highlight) => {
			project.highlights.push(highlight.textContent.trim());
		});

		item.addEventListener("click", async () => {
			openModal(project);
		});
	}
</script>
