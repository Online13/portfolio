---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
	slug: string;
	description: string;
	title: string;
	link: string;
	full_description: string;
	technologies: string[];
	role?: string;
	highlights: string[];
}

const {
	slug,
	title,
	description,
	full_description,
	technologies,
	link,
	role,
	highlights,
} = Astro.props;
---

<tr
	id={`project-${slug}`}
	data-slug={slug}
	data-link={link}
	data-title={title}
	data-description={description}
	data-role={role}
	class="project-item group border-b border-gray-200 cursor-pointer hover:bg-stone-500/10"
>
	<td
		class="py-3 pr-4 font-semibold text-black sm:whitespace-nowrap group-hover:pl-4 transition-all duration-300"
	>
		{title}
		<span class="block pt-1 font-normal text-gray-700 sm:hidden">{description}</span>
	</td>
	<td class="hidden py-3 pr-4 text-gray-700 sm:table-cell">{description}</td>
	<td
		class="py-3 text-right text-gray-400 group-hover:text-gray-700 group-hover:pr-4 transition-all duration-300"
	>
		<ArrowUpRight
			class="inline w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
		/>
		<template class="project-full-desc">{full_description}</template>
		<ul class="projet-technos" style="display: none;">
			{technologies.map((tech) => <li>{tech}</li>)}
		</ul>
		<ul class="project-highlights" style="display: none;">
			{highlights.map((highlight) => <li>{highlight}</li>)}
		</ul>
	</td>
</tr>
