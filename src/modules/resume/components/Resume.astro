---
import { Image } from "astro:assets";
import picture from "@/assets/images/picture.png";
import { getResume } from "@/services/content";
import { formatMonth } from "@/modules/resume/utils/dates";
import FluidHover from "@/components/FluidHover.astro";
import { t, toLocale } from "@/services/i18n";
import ResumeSection from "./ResumeSection.astro";

// The resume sheet: shown in the home page's full-screen overlay, and the only thing printed from it (public/cv*.pdf).
const locale = toLocale(Astro.currentLocale);
const text = t(locale).resume;
const {
	name,
	title,
	location,
	about,
	tools,
	languages,
	contacts,
	experiences,
	projects,
	education,
	certifications,
} = await getResume(locale);
---

<svg style="display: none" aria-hidden="true">
	<symbol
		id="resume-external"
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M6 3.5h6.5V10M12.5 3.5L5 11"></path>
	</symbol>
</svg>
<article class="resume-sheet text-pretty text-foreground antialiased">
	<header class="max-sm:px-4">
		<div class="flex items-center gap-5">
			<Image
				src={picture}
				alt={name}
				width={120}
				height={120}
				class="size-15 shrink-0 rounded-md object-cover grayscale"
			/>
			<div>
				<h2 class="text-[19px] font-bold">
					{name}
				</h2>
				<p class="mt-0.5 text-sm text-body">{title}</p>
				<p class="text-[13px] text-subtle">{location}</p>
			</div>
		</div>
		<p class="mt-5 text-sm leading-relaxed text-body">
			{
				contacts.map(({ href, label }, i) => (
					<>
						<a href={href} class="inline-flex items-center gap-1">
							{label}
							<svg class="size-3 shrink-0 text-subtle">
								<use href="#resume-external" />
							</svg>
						</a>
						{i < contacts.length - 1 && ", "}
					</>
				))
			}
		</p>
	</header>

	<hr class="my-4 border-separator max-sm:mx-4" />

	<div class="space-y-4">
		<ResumeSection label={text.about}>
			<p class="text-sm leading-relaxed text-body p-4">{about}</p>
		</ResumeSection>

		<ResumeSection label={text.experience}>
			<FluidHover class="space-y-4">
				{
					experiences.map((role) => (
						<div
							class="grid grid-cols-[150px_1fr] gap-8 max-sm:grid-cols-1 max-sm:gap-3 break-inside-avoid p-4"
							data-fluid-item
						>
							<div>
								<h3 class="text-sm font-medium">{role.role}</h3>
								<p class="text-[13px] text-body">{role.company}</p>
								<p class="text-[13px] text-subtle">
									{[role.type && text.jobTypes[role.type], role.city].filter(Boolean).join(" · ")}
								</p>
								<p class="text-[13px] text-subtle tabular-nums">
									{role.years}
								</p>
							</div>
							<ul class="space-y-1.5">
								{role.highlights.map((highlight) => (
									<li class="relative pl-4 text-sm leading-relaxed text-body before:absolute before:top-[0.6em] before:left-0 before:size-1 before:rounded-full before:bg-subtle">
										{highlight}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</FluidHover>
		</ResumeSection>

		<ResumeSection label={text.sideProjects}>
			<FluidHover>
				{
					projects.map((project) => (
						<div class="break-inside-avoid p-4" data-fluid-item>
							<div>
								<a
									href={project.link}
									class="inline-flex items-center gap-1 text-sm font-medium"
								>
									{project.title}
									<svg class="size-3 shrink-0 text-subtle">
										<use href="#resume-external" />
									</svg>
								</a>
							</div>
							<p class="text-sm leading-relaxed text-body">
								<>
									<span class="text-[13px] leading-relaxed text-subtle">
										{project.technologies.join(" · ")}
									</span>
									<br />
								</>
								{project.description}
							</p>
						</div>
					))
				}
			</FluidHover>
		</ResumeSection>

		<ResumeSection label={text.education}>
			<FluidHover>
				{
					education.map((entry) => (
						<div class="break-inside-avoid p-4" data-fluid-item>
							<div class="flex flex-wrap items-baseline gap-x-4">
								<h3 class="text-sm font-medium">{entry.school}</h3>
								<p class="text-[13px] text-subtle tabular-nums">
									{entry.end
										? `${entry.start} – ${entry.end}`
										: entry.start}
								</p>
							</div>
							<p class="text-sm leading-relaxed text-body">
								{entry.degree}
							</p>
						</div>
					))
				}
			</FluidHover>
		</ResumeSection>

		<ResumeSection label={text.certifications}>
			<FluidHover axis="xy" class="grid grid-cols-[1fr_1fr] max-sm:grid-cols-1">
				{
					certifications.map((entry) => (
						<div class="break-inside-avoid p-4" data-fluid-item>
							{entry.href ? (
								<a
									href={entry.href}
									class="inline-flex items-center gap-1 text-sm font-medium"
								>
									{entry.title}
									<svg class="size-3 shrink-0 text-subtle">
										<use href="#resume-external" />
									</svg>
								</a>
							) : (
								<h3 class="text-sm font-medium">{entry.title}</h3>
							)}
							<p class="text-[13px] text-subtle">
								{[entry.issuer, formatMonth(entry.date, locale)]
									.filter(Boolean)
									.join(" · ")}
							</p>
						</div>
					))
				}
			</FluidHover>
		</ResumeSection>

		<ResumeSection label={text.languages}>
			<p class="text-sm text-body p-4">
				{
					languages
						.map(({ name, level }) => `${name} (${level})`)
						.join(", ")
				}
			</p>
		</ResumeSection>

		<ResumeSection label={text.tools}>
			<FluidHover class="flex flex-col break-inside-avoid">
				{
					tools.map(({ label, value }) => (
						<div class="p-4" data-fluid-item>
							<h3 class="text-sm font-medium">{label}</h3>
							<p class="text-sm leading-relaxed text-body">{value}</p>
						</div>
					))
				}
			</FluidHover>
		</ResumeSection>
	</div>

	<footer
		class="mt-12 border-t border-separator pt-5 text-center text-[11px] tracking-wide text-subtle"
	>
		{name} · nekena-rayane.com · rratiarivelo@gmail.com
	</footer>
</article>
