---
import Table from "@/components/Table.astro";

export interface Entry {
	title: string;
	subtitle?: string;
	date: string;
	detail?: string;
}

interface Props {
	heading: string;
	groups: { label: string; entries: Entry[] }[];
}

const { heading, groups } = Astro.props;

const columns = [{ label: "Year", class: "w-14" }, heading, "Date"];
---

<Table columns={columns}>
	{
		groups.map(({ label, entries }) => (
			<tbody class="border-t border-gray-300">
				{entries.map((entry, i) => (
					<tr class="group align-top">
						{i === 0 && (
							<th
								scope="rowgroup"
								rowspan={entries.length}
								class="py-3 pr-4 font-normal text-gray-400 tabular-nums"
							>
								{label}
							</th>
						)}
						<td class:list={["py-3 pr-4", i > 0 && "border-t border-gray-100"]}>
							<div class="font-semibold text-black">{entry.title}</div>
							{entry.subtitle && (
								<div class="text-gray-600">{entry.subtitle}</div>
							)}
						</td>
						<td
							class:list={[
								"py-3 text-right whitespace-nowrap",
								i > 0 && "border-t border-gray-100",
							]}
						>
							<div class="text-gray-700">{entry.date}</div>
							{entry.detail && <div class="text-gray-400">{entry.detail}</div>}
						</td>
					</tr>
				))}
			</tbody>
		))
	}
</Table>
