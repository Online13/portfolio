---
import { Download, X } from "@lucide/astro";
import Resume from "./Resume.astro";
---

<!--
	Opened by any link to #resume: a full-screen sheet that slides up over the page. Shown with show(), not
	showModal(): the top layer would lift it above the light (TreeShadow's canvas), while inside #page it
	stays under it, lit like the rest of the page.
-->
<dialog
	id="resume"
	aria-label="Resume"
	aria-modal="true"
	class="fixed inset-0 z-50 m-0 size-full max-h-none max-w-none translate-y-6 overflow-y-auto overscroll-contain border-0 bg-white p-0 opacity-0 transition-[opacity,translate,display] transition-discrete duration-300 ease-out open:translate-y-0 open:opacity-100 starting:open:translate-y-6 starting:open:opacity-0 motion-reduce:transition-none"
>
	<div class="mx-auto flex max-w-190 flex-col gap-3 px-4 py-10 sm:py-16 print:max-w-none print:p-0">
		<div data-resume-toolbar class="flex items-center justify-between">
			<button
				type="button"
				data-resume-close
				aria-label="Close"
				class="rounded-full border border-neutral-200 bg-white p-2 text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-black"
			>
				<X class="size-4" aria-hidden="true" />
			</button>
			<a
				href="/cv.pdf"
				download="CV-Nekena-Rayane-Ratiarivelo.pdf"
				data-resume-download
				class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm text-neutral-800 transition-colors hover:bg-neutral-100"
			>
				<Download class="size-4" aria-hidden="true" />
				Download PDF
			</a>
		</div>
		<Resume />
	</div>
</dialog>

<script>
	import { track } from "@/modules/shared/lib/analytics";

	const dialog = document.getElementById("resume") as HTMLDialogElement;
	const page = dialog.parentElement!;

	// Without the top layer, keeping focus in the resume and closing on Escape are done here.
	const setOpen = (open: boolean) => {
		if (open === dialog.open) return;
		if (open) dialog.show();
		else dialog.close();
		for (const sibling of page.children) {
			if (sibling !== dialog) (sibling as HTMLElement).inert = open;
		}
		if (open) {
			track("resume_opened");
			dialog.scrollTop = 0;
			dialog.querySelector<HTMLElement>("[data-resume-close]")!.focus({ preventScroll: true });
		} else page.querySelector<HTMLElement>('a[href="#resume"]')?.focus({ preventScroll: true });
	};

	// #resume opens the resume, so the link works from anywhere and can be shared.
	const sync = () => setOpen(location.hash === "#resume");

	// Closing drops #resume without following "#", which would scroll the page back to the top.
	const close = () => {
		history.pushState(null, "", location.pathname + location.search);
		sync();
	};

	dialog.querySelector("[data-resume-close]")!.addEventListener("click", close);
	dialog.querySelector("[data-resume-download]")!.addEventListener("click", () => track("resume_downloaded"));
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && dialog.open) close();
	});

	sync();
	window.addEventListener("hashchange", sync);
</script>
