---
import { ArrowLeft, Download } from "@lucide/astro";
import ExperienceSection from "@/modules/experience/ExperienceSection.astro";
import EducationSection from "@/modules/education/EducationSection.astro";
import ExperienceDetail from "@/modules/experience/ExperienceDetail.astro";

// Two views side by side, each scrolling on its own so the resume keeps its place while a role is open.
// Opening a role (#resume/<id>) slides the resume out to the left and the role's detail in from the right.
const view = [
	"absolute inset-0 overflow-y-auto overscroll-contain [scrollbar-gutter:stable]",
	// Hidden, not overflow-hidden: toggling overflow leaves Chrome keyboard-scrolling a stale, unscrollable target.
	"group-data-moving/resume:[&::-webkit-scrollbar-thumb]:bg-transparent group-data-moving/resume:[&::-webkit-scrollbar-track]:bg-transparent",
	"transition-transform duration-700 ease-spring motion-reduce:transition-none",
];
const column = "flex justify-center px-6 pt-30 pb-24";
---

<div
	data-resume-view
	class:list={[view, "group-data-detail/resume:-translate-x-full"]}
>
	<div class={column}>
		<div class="w-full max-w-160 space-y-8">
			<div class="flex items-center justify-between gap-4">
				<div class="space-y-1">
					<div class="flex items-center gap-2">
						<a
							href="#"
							data-resume-close
							aria-label="Back"
							class="-ml-1 rounded-full p-1 text-gray-600 transition-colors hover:bg-neutral-100 hover:text-black"
						>
							<ArrowLeft class="h-5 w-5" aria-hidden="true" />
						</a>
						<h1 class="text-2xl font-bold">Resume</h1>
					</div>
					<p class="text-sm text-gray-600">
						My professional experience and education.
					</p>
				</div>
				<a
					href="/cv.pdf"
					download="CV-Nekena-Rayane-Ratiarivelo.pdf"
					class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-neutral-200 px-4 py-2 text-sm font-semibold text-neutral-800 transition-colors hover:bg-neutral-50"
				>
					<Download class="h-4 w-4" aria-hidden="true" />
					Download PDF
				</a>
			</div>
			<div class="space-y-8 w-full">
				<ExperienceSection />
				<EducationSection />
			</div>
		</div>
	</div>
</div>
<div
	data-detail-view
	inert
	class:list={[view, "translate-x-full group-data-detail/resume:translate-x-0"]}
>
	<div class={column}>
		<div class="w-full max-w-160">
			<ExperienceDetail />
		</div>
	</div>
</div>
