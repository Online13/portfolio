---
import { SOCIAL_LINKS } from "@/data";

export type Props = { title?: string; description?: string; noindex?: boolean };

const NAME = "Nekena Rayane";
const {
  title,
  description = "Nekena Rayane, software engineer in Antananarivo. Web and mobile apps with React Native, open to remote collaborations.",
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${NAME}` : `${NAME} | Software engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nekena Rayane Ratiarivelo",
  alternateName: NAME,
  jobTitle: "Software engineer",
  url: Astro.site,
  image: ogImage,
  address: { "@type": "PostalAddress", addressLocality: "Antananarivo", addressCountry: "MG" },
  sameAs: SOCIAL_LINKS.filter((link) => ["github", "linkedin", "facebook"].includes(link.type)).map((link) => link.to),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Nekena Rayane Ratiarivelo" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${NAME}, software engineer`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
