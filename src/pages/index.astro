---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@/modules/about/AboutSection.astro";
import BlogSection from "@/modules/blog/components/BlogSection.astro";
import ActiveProjectSection from "@/modules/project/components/ActiveProjectSection.astro";
import ProjectDetailModal from "@/modules/project/components/ProjectDetailModal.astro";
import Footer from "@/modules/shared/components/Footer.astro";
import TreeShadow from "@/modules/shared/components/TreeShadow.astro";
---

<MainLayout title="Rayane">
	<div
		id="main-content"
		class="w-full relative z-20 bg-white flex flex-col items-center"
	>
		<div class="flex justify-center pb-12">
			<div
				class="w-full flex flex-col items-center max-w-160 pt-30 relative pb-4"
			>
				<div class="w-full space-y-16 relative">
					<AboutSection />
					<ActiveProjectSection />
					<BlogSection />
				</div>
			</div>
		</div>
	</div>
	<Footer />
	<ProjectDetailModal />
	<TreeShadow />
</MainLayout>
