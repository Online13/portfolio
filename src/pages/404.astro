---
import "../styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Not found" noindex>
	<div class="w-full min-h-screen flex justify-center">
		<div class="w-full max-w-160 pt-30 pb-12 space-y-4">
			<div class="space-y-1">
				<h1 class="text-2xl font-bold">404</h1>
				<p class="text-gray-700">This page doesn't exist.</p>
			</div>
			<p class="text-gray-600 max-w-130">
				The link may be broken, or the page may have moved. <a
					href="/"
					class="trigger text-gray-900 font-semibold">Back to the home page</a
				>.
			</p>
		</div>
	</div>
</MainLayout>
